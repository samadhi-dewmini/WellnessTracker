<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Emoji Circle Background -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF3E0">

            <TextView
                android:id="@+id/mood_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="😊"
                android:textSize="36sp"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <!-- Content Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <!-- Date/Time -->
            <TextView
                android:id="@+id/mood_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jan 01, 2025 10:30"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF9800"/>

            <!-- Note -->
            <TextView
                android:id="@+id/mood_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feeling great today!"
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/delete_mood_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:contentDescription="Delete mood"
            app:tint="#F44336" />

    </LinearLayout>

</androidx.cardview.widget.CardView>